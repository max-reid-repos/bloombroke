# Copy to .env and adjust. .env is gitignored.
PORT=3020

# ---- Pro (checkout stays closed until the first four are all set) ----
# live (default) or test. test reads the *_TEST names below and shows a demo banner.
STRIPE_MODE=
# Stripe secret key (sk_live_... or sk_test_...). Never commit it.
STRIPE_SECRET_KEY=
# The $42 monthly price; written by scripts/stripe-setup.js.
STRIPE_PRICE_ID=
# Optional: the $420 yearly price; written by scripts/stripe-setup.js. Without it, yearly says "not available yet".
STRIPE_PRICE_ID_YEARLY=
# Signing secret of the /api/stripe/webhook endpoint; written by scripts/stripe-setup.js.
STRIPE_WEBHOOK_SECRET=
# 32+ random characters; encrypts the 24 hour key reveal. Written by scripts/stripe-setup.js if missing.
PRO_SECRET=
# Optional: the Pro-only Billing Portal configuration; written by scripts/stripe-setup.js.
STRIPE_PORTAL_CONFIG_ID=
# Optional: where the Pro database lives (default var/pro.db).
PRO_DB_PATH=
# Optional: public site address for Stripe return links (default https://bloombroke.com).
PUBLIC_URL=
# Test (demo) mode key set, used only when STRIPE_MODE=test; written by stripe-setup.js in test mode.
STRIPE_SECRET_KEY_TEST=
STRIPE_PRICE_ID_TEST=
STRIPE_PRICE_ID_YEARLY_TEST=
STRIPE_WEBHOOK_SECRET_TEST=
STRIPE_PORTAL_CONFIG_ID_TEST=
# Optional: the Terms version buyers accept, stored with each licence (default 2026-09-27).
TERMS_VERSION=
# Optional: closed = nobody can start a checkout; PRO shows "Pro opens soon." Existing keys keep working. Unset: checkout as configured above.
PRO_CHECKOUT=

# ---- FOUNDERS SEATS (pro/founders.js, /founders) ----
# open = founders can save a card for a seat (Stripe Checkout in setup mode, nobody is charged
# until the goal is reached). Anything else: /founders shows the seats with "Seats open soon."
# Needs the Stripe keys above, STRIPE_WEBHOOK_SECRET and PRO_SECRET. In STRIPE_MODE=test the page shows TEST MODE.
FOUNDERS=
# Optional: the goal in whole US dollars (default 17640).
FOUNDERS_GOAL_USD=
# Optional: the last day seats can be saved and charged, YYYY-MM-DD, the end of that day UTC (default 2026-12-15).
FOUNDERS_DEADLINE=

# ---- TIPS (pro/tips.js): "Fuel the feed" on /founders, a named fish in FISHTANK ----
# open = tips can be paid. Open only once licensed prices are live. Unset: nothing about tips shows.
TIPS=

# ---- PINGS: Web Push for Pro (pro/push.js). Without both keys pings are off. ----
# Make a pair once: node scripts/vapid-keys.js. A new pair makes everyone turn pings on again. Never commit the private key.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Optional: who push services may contact (default mailto:hello@bloombroke.com).
VAPID_SUBJECT=

# ---- SPONSOR (lib/sponsors.js) ----
# Optional: the price of the sponsor line in whole dollars a week, e.g. 99 (shown as "$99 a week").
# Unset or empty: the SPONSOR screen shows no price line at all. A restart picks up a change.
SPONSOR_PRICE=

# ---- BBRK and SPONSOR audience numbers (lib/datafast.js) ----
# Optional: a read-only, website-scoped DataFast key (df_...), DataFast: Website settings -> API.
# Without it the visitor numbers show --. Never commit it.
DATAFAST_API_KEY=
